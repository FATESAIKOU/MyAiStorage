{
  "queries": [
    {
      "name": "中文單詞命中訊息",
      "query": {"text": "接續點"},
      "expected": {
        "sessions": ["opencode:s1"],
        "matches": {"opencode:s1": ["m1a", "m1d"]}
      }
    },
    {
      "name": "多詞 AND（同一則訊息內都要命中）",
      "query": {"text": "接續點 交接單"},
      "expected": {
        "sessions": ["opencode:s1"],
        "matches": {"opencode:s1": ["m1d"]}
      }
    },
    {
      "name": "引號片語",
      "query": {"text": "\"交接單由持有者\""},
      "expected": {
        "sessions": ["opencode:s1"],
        "matches": {"opencode:s1": ["m1b"]}
      }
    },
    {
      "name": "兩字查詢走 LIKE",
      "query": {"text": "接續"},
      "expected": {
        "sessions": ["opencode:s1"],
        "matches": {"opencode:s1": ["m1a", "m1d"]},
        "matched_by": "like"
      }
    },
    {
      "name": "含短詞的查詢整組走 LIKE",
      "query": {"text": "ab 交接單"},
      "expected": {"sessions": [], "matches": {}}
    },
    {
      "name": "標題篩選",
      "query": {"title_contains": "設計"},
      "expected": {
        "sessions": ["opencode:s1"],
        "matches": {"opencode:s1": []}
      }
    },
    {
      "name": "來源篩選",
      "query": {"source": "claude-code"},
      "expected": {"sessions": ["opencode:s2"], "matches": {"opencode:s2": []}}
    },
    {
      "name": "狀態篩選依更新時間排序",
      "query": {"status": "running"},
      "expected": {
        "sessions": ["opencode:s2", "opencode:s3"],
        "matches": {"opencode:s2": [], "opencode:s3": []}
      }
    },
    {
      "name": "案件篩選",
      "query": {"case_id": "case-agora"},
      "expected": {"sessions": ["opencode:s1"], "matches": {"opencode:s1": []}}
    },
    {
      "name": "產生者篩選",
      "query": {"producer": "profile:worker-2"},
      "expected": {"sessions": ["opencode:s2"], "matches": {"opencode:s2": []}}
    },
    {
      "name": "只要主 Session",
      "query": {"parent_id": ""},
      "expected": {
        "sessions": ["opencode:s1", "opencode:s3"],
        "matches": {"opencode:s1": [], "opencode:s3": []}
      }
    },
    {
      "name": "指定母 Session",
      "query": {"parent_id": "opencode:s1"},
      "expected": {"sessions": ["opencode:s2"], "matches": {"opencode:s2": []}}
    },
    {
      "name": "生成中篩選",
      "query": {"in_progress": true},
      "expected": {"sessions": ["opencode:s2"], "matches": {"opencode:s2": []}}
    },
    {
      "name": "時間下限",
      "query": {"updated_after": "2026-09-26T00:00:00Z"},
      "expected": {
        "sessions": ["opencode:s1", "opencode:s2"],
        "matches": {"opencode:s1": [], "opencode:s2": []}
      }
    },
    {
      "name": "時間上限",
      "query": {"updated_before": "2026-09-26T00:00:00Z"},
      "expected": {"sessions": ["opencode:s3"], "matches": {"opencode:s3": []}}
    },
    {
      "name": "日文命中",
      "query": {"text": "引き継ぎ"},
      "expected": {
        "sessions": ["opencode:s2"],
        "matches": {"opencode:s2": ["n1"]}
      }
    },
    {
      "name": "英文命中",
      "query": {"text": "hello"},
      "expected": {
        "sessions": ["opencode:s2"],
        "matches": {"opencode:s2": ["n2"]}
      }
    },
    {
      "name": "只在標題命中也回傳（matches 為空）",
      "query": {"text": "plain"},
      "expected": {
        "sessions": ["opencode:s3"],
        "matches": {"opencode:s3": []}
      }
    },
    {
      "name": "標題命中（LIKE 路徑）",
      "query": {"text": "メモ"},
      "expected": {
        "sessions": ["opencode:s2"],
        "matches": {"opencode:s2": []}
      }
    },
    {
      "name": "查無結果",
      "query": {"text": "不存在的詞語串"},
      "expected": {"sessions": [], "matches": {}}
    },
    {
      "name": "全文加篩選命中",
      "query": {"text": "交接單", "status": "stopped"},
      "expected": {
        "sessions": ["opencode:s1"],
        "matches": {"opencode:s1": ["m1b", "m1d"]}
      }
    },
    {
      "name": "全文加篩選落空",
      "query": {"text": "交接單", "source": "claude-code"},
      "expected": {"sessions": [], "matches": {}}
    },
    {
      "name": "轉換失敗仍可用 metadata 查到",
      "query": {"source": "opencode", "status": "running"},
      "expected": {"sessions": ["opencode:s3"], "matches": {"opencode:s3": []}}
    },
    {
      "name": "分頁第一頁",
      "query": {"limit": 1},
      "expected": {
        "sessions": ["opencode:s1"],
        "matches": {"opencode:s1": []},
        "next_cursor": ["2026-09-27T09:00:00.000Z", "opencode:s1"]
      }
    },
    {
      "name": "分頁第二頁",
      "query": {"limit": 1, "cursor": ["2026-09-27T09:00:00.000Z", "opencode:s1"]},
      "expected": {
        "sessions": ["opencode:s2"],
        "matches": {"opencode:s2": []},
        "next_cursor": ["2026-09-26T08:10:00.000Z", "opencode:s2"]
      }
    },
    {
      "name": "分頁最後一頁無下一頁",
      "query": {"limit": 1, "cursor": ["2026-09-26T08:10:00.000Z", "opencode:s2"]},
      "expected": {
        "sessions": ["opencode:s3"],
        "matches": {"opencode:s3": []},
        "next_cursor": null
      }
    }
  ]
}
