{
  "$schema": "https://opencode.ai/config.json",
  "model": "__MODEL__",
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  "instructions": [],
  "skills": {
    "paths": ["/opt/aistorage/opencode/skills"]
  },
  "plugin": ["/opt/aistorage/opencode/plugin/aistorage.ts"],
  "provider": {
    "__PROVIDER__": {
      "options": {
        "apiKey": "__API_KEY_FILE__"
      }
    }
  },
  "permission": {
    "external_directory": {
      "/secrets/**": "deny",
      "*": "allow"
    }
  },
  "mcp": {},
  "lsp": false
}
